# Local overrides. Copy to .env and edit; .env is never source-controlled.

# Pi agent home (defaults to ./agent-home inside the repository).
PI_HOME=./agent-home

# --- Credentials -----------------------------------------------------------
# Pi authenticates through agent-home/.pi/agent/auth.json; copy the adjacent
# auth.json.example and fill it in, or run `pi` once and use /login. The keys
# below are what that template interpolates.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Endpoint overrides ----------------------------------------------------
# Leave unset to talk to the official APIs.
#
# Pi endpoints do NOT live here. Pi only accepts a custom baseUrl from a provider
# entry in agent-home/.pi/agent/models.json, which is untracked for exactly that
# reason — copy models.json.example and add the provider you want to redirect:
#
#   "providers": { "openai": { "baseUrl": "https://gateway.example.com/v1" } }
#
# Config beats an extension here: every pi channel reads models.json, while the
# judge runs with --no-extensions and would silently fall back to the official
# endpoint.
#
# Codex takes its endpoint as a session config override, so it stays an env var:
# CODEX_OPENAI_BASE_URL=

# --- Benchmark sites -------------------------------------------------------
# Origin of the local site host that serves tasks declaring `local_site`.
# Set it when the default port is taken, e.g. by a second worktree.
# BENCHMARK_SITES_ORIGIN=http://127.0.0.1:4374

# --- Binaries --------------------------------------------------------------
# Browser tool binary; resolved from PATH when unset.
WIEK_BROWSER_BIN=wiek-browser

# pi binary; resolved from PATH when unset.
PI_BIN=pi

# codex binary; falls back to PATH, then the SDK-bundled CLI.
# CODEX_BIN=codex

# wiek-lite development runtime used by scripts/bootstrap.sh when no --wiek-tag is
# given. Point it at index.js inside your local wiek-lite build.
# WIEK_DEV_INDEX=
