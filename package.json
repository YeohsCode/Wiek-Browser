{
  "name": "wiek-browser",
  "version": "0.24.0",
  "private": true,
  "license": "MIT",
  "description": "An independent local Chromium browser and agent workspace",
  "type": "module",
  "main": "app/main.cjs",
  "bin": {
    "wiek-browser": "cli/wiek-browser.mjs",
    "vek-browser": "cli/vek-browser.mjs"
  },
  "scripts": {
    "start": "electron .",
    "build:sdk": "npm --prefix packages/sdk run build",
    "test:upstream": "node tools/run-sdk-regression.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/run-comparison.mjs",
    "dist": "electron-builder --mac dir",
    "test:workbench": "node tests/workbench-integration.mjs",
    "build:desktop-native": "node tools/build-selection-helper.mjs",
    "build:brand": "node tools/build-brand-assets.mjs",
    "predist": "node tools/check-package-idle.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.wiek.browser",
    "productName": "Wiek Browser",
    "electronDist": "node_modules/electron/dist",
    "asar": false,
    "files": [
      "app/**",
      "cli/**",
      "packages/sdk/dist/**",
      "packages/sdk/skill-body/**",
      "packages/sdk/LICENSE",
      "NOTICE.md",
      "package.json",
      "models/**",
      "skills/wiek-browser/**",
      "skills/vek-browser/**",
      "!app/**/__pycache__/**",
      "!app/**/*.pyc"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record audio when you choose Voice input in Wiek Browser. Audio is transcribed locally."
      },
      "icon": "app/assets/wiek.icns"
    }
  }
}
