{
  "name": "wiek-browser-sdk",
  "version": "0.1.0",
  "description": "Standalone Wiek Browser CDP automation runtime",
  "type": "module",
  "bin": {
    "wiek-sdk": "./dist/out/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist artifacts",
    "build": "node scripts/build.mjs",
    "check:skill-translation": "node scripts/check-skill-translation.mjs",
    "e2e": "node ../../tools/run-sdk-regression.mjs --browser",
    "style:check": "prettier --check \"src/**/*.{ts,mjs,js}\" \"scripts/**/*.{ts,mjs,js}\" package.json README.md",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run check:skill-translation && npm run typecheck && node ../../tools/run-sdk-regression.mjs",
    "validate:site-skills": "npm run build && WIEK_BROWSER_AGENT_WORKSPACE=../../skills/wiek-browser node dist/scripts/validate-site-skills.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.15.29",
    "esbuild": "^0.28.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "acorn": "^8.16.0"
  }
}
