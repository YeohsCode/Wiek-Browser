VEK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$VEK_ROOT/dist/mac-arm64/Wiek Browser.app/Contents/MacOS/Wiek Browser" ]; then
